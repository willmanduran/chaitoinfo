---
import '../styles/global.css';

// Permite recibir propiedades en cada página (como el title)
const { title, description } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Chaito</title>
    <meta name="description" content={description} />
    
    <!-- Fuente Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="antialiased min-h-screen flex flex-col" style="font-family: 'Montserrat', sans-serif;">
    
    {/* HEADER ESTÁTICO REUTILIZABLE */}
    <header class="sticky top-0 z-50 w-full text-black shadow-md flex flex-col bg-white">
      <div class="bg-[#f6f0fc] w-full">
        <div class="w-full px-4 lg:px-8 h-20 flex items-center justify-between">
          <a href="https://chaito.com.bo" class="flex items-center gap-3">
            <img src="/logo.png" width="126" height="40" alt="Chaito Logo" />
          </a>
          
          <!-- Links de navegación de regreso -->
          <div class="flex items-center gap-5 text-sm font-medium text-black/70">
            <a href="https://chaito.com.bo" class="hover:text-black hover:underline underline-offset-4 transition-all">
              Volver a la tienda
            </a>
          </div>
        </div>
      </div>
    </header>

    {/* AQUÍ SE INYECTA EL CONTENIDO DE CADA PÁGINA */}
    <main class="flex-grow">
      <slot />
    </main>

    {/* FOOTER ESTÁTICO REUTILIZABLE */}
    <footer class="w-full bg-white border-t border-gray-200 py-8 mt-auto">
      <div class="container text-center text-sm text-gray-500">
        &copy; {new Date().getFullYear()} Chaito Marketplace. Todos los derechos reservados.
      </div>
    </footer>
  </body>
</html>